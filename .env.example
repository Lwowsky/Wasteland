# Public frontend origin used for canonical/SEO URLs.
# Example production value: https://example.com
# Leave empty locally to use the current browser origin.
VITE_SITE_URL=

# Cloudflare Worker/API origin.
# Production can stay empty when /api is served on the same origin.
# For separate local frontend/worker processes use the local Worker URL,
# for example: http://localhost:8787
VITE_API_URL=http://localhost:8787

# Firebase Web app configuration used by the admin authentication UI.
# These are public client configuration values; keep privileged server secrets out of VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
