# Optional canonical override; by default the active host and base path are detected.
VITE_SITE_URL=

# Cloudflare Worker/API origin.
# Static hosts (GitHub Pages) require a public HTTPS Worker origin.
# Other hosts can reuse it or proxy /api on the same origin. No source edits.
# For separate local frontend/worker processes use the local Worker URL,
# for example: http://localhost:8787
VITE_API_URL=http://localhost:8787

# Firebase Web app configuration used by the admin authentication UI.
# These are public client configuration values; keep privileged server secrets out of VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# For another host served from a subfolder, optionally set VITE_BASE_PATH=/folder/ on build.
# GitHub Actions detects the repository path automatically.
